APP_NAME="Sama Al Tariq"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://samaaltariq.org

APP_LOCALE=en
APP_TIMEZONE=Asia/Dubai

# ---------------------------------------------------------------------------
# Database — hPanel → Databases → Management → "Create new database".
# Names are prefixed with your account id (u123456789_…).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_samaaltariq
DB_USERNAME=uXXXXXXXX_sama
DB_PASSWORD=

# ---------------------------------------------------------------------------
# First administrator, created by `php artisan db:seed`.
# Leave ADMIN_PASSWORD unset to have one generated and printed once.
# Remove it from .env afterwards.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@samaaltariq.org
ADMIN_NAME="Site Admin"
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Mail — hPanel → Emails. Used for enquiry notifications and client credentials.
# Port 465 with SMTP_SCHEME=smtps is the reliable combination on Hostinger;
# 587 needs SMTP_SCHEME=smtp.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@samaaltariq.org
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@samaaltariq.org
MAIL_FROM_NAME="${APP_NAME}"

# Where new website enquiries are delivered (defaults to MAIL_FROM_ADDRESS).
ENQUIRY_TO=info@samaaltariq.org

# ---------------------------------------------------------------------------
# Sessions, cache and queue all use the database, so nothing extra has to be
# installed on shared hosting and no long-running worker is required.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=warning

VITE_APP_NAME="${APP_NAME}"
